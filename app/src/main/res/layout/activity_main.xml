<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_desc"
            android:textSize="14sp"
            android:textColor="#666666"
            android:paddingBottom="16dp" />

        <Switch
            android:id="@+id/swVolumeKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_volume_key"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_volume_key"
            android:textSize="12sp"
            android:textColor="#888888"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp" />

        <Switch
            android:id="@+id/swControlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_control_bar"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_control_bar"
            android:textSize="12sp"
            android:textColor="#888888"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_accessibility" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_refresh" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tip_footer"
            android:textSize="12sp"
            android:textColor="#999999"
            android:paddingTop="16dp" />
    </LinearLayout>
</ScrollView>
